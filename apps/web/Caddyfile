# Static SPA server. Railway/host injects PORT; default 8080 for local runs.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Long-cache the hashed asset bundles.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Client-side routing: unknown paths fall back to index.html.
	try_files {path} /index.html
	file_server
}
