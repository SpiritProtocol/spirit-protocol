NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://spirit:spirit@localhost:5433/spirit_protocol

JWT_SECRET=change-this-to-a-long-random-string

# "dev" skips Telegram HMAC verification when no bot token is set, so the app
# runs without a real Telegram bot during local development / E2E tests.
# Use "strict" (with TELEGRAM_BOT_TOKEN set) for anything resembling production.
TELEGRAM_AUTH_MODE=dev
TELEGRAM_BOT_TOKEN=

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# All MVP services run in mock mode. "real" is reserved for future
# implementations behind the same interfaces.
HARDWARE_VERIFICATION_MODE=mock
BLOCKCHAIN_MODE=mock
PAYMENT_MODE=mock
VAULT_MODE=mock

CORS_ORIGIN=*
